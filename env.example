BOT_TOKEN=123456:telegram_bot_token
BOT_OWNER_ID=123456789
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=sticker_guard

# Local development: leave these empty and the bot will use long polling.
# Render Web Service: render.yaml can fill WEBHOOK_URL automatically from Render's hostname.
# Local development: leave WEBHOOK_URL empty.
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=10000
LOG_LEVEL=INFO
